{
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "example": 1234567890
    },
    "username": {
      "type": "string",
      "example": "agent_nok_01"
    },
    "environment": {
      "type": "string",
      "description": "The environment in which the account is created, e.g., Production or Development",
      "enum": ["production", "development", "staging"],
      "example": "production"
    },
    "isDefaultAccount": {
      "type": "boolean",
      "example": false
    },
    "active": {
      "type": "boolean",
      "example": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "example": "2024-01-01T12:00:00Z"
    },
    "lastPasswordChangeAt": {
      "type": "string",
      "format": "date-time",
      "example": "2024-06-15T08:30:00Z"
    },
    "passwordAgeSeconds": {
      "type": "integer",
      "example": 900000
    },
    "lastOtaAsyncAt": {
      "type": "string",
      "format": "date-time",
      "example": "2024-06-20T14:45:00Z"
    }
  }
}
