{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "NokBookingAPI": "Debug",
        "NokCore": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=webdba;Database=ApplicationLog;User Id=webadmin;Password=wQuPaaSDZ6WRq9Mz;TrustServerCertificate=True;",
          "tableName": "NFC_Log",
          "autoCreateSqlTable": false,
          "columnOptionsSection": {
            "removeStandardColumns": [
              "MessageTemplate",
              "Properties"
            ],
            "customColumns": [
              {
                "ColumnName": "HostName",
                "DataType": "nvarchar",
                "DataLength": 128,
                "AllowNull": true
              },
              {
                "ColumnName": "Payload",
                "DataType": "varchar",
                "DataLength": -1,
                "AllowNull": true
              }
            ]
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
